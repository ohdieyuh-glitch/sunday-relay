+def analyse(sender, viewer, shift_s=0.0):
+    ts = [s[0] for s in sender]
+    land_after = [None] * len(sender)   # landing time for ground samples shortly after an air run
+    last_land = None
+    for i, s in enumerate(sender):
+        if s[1] in AIR:
+            last_land = None
+        elif i > 0 and sender[i - 1][1] in AIR:
+            last_land = s[0]
+        land_after[i] = None if s[1] in AIR else last_land
+    air_gaps, land_gaps, ground_gaps = [], [], []
+    settle_gaps = []   # W2 D4
+    recv_air = 0
+    for (t, fig, mot, z, d) in viewer:
+        if mot in AIR:
+            recv_air += 1
+        tt = t - d + shift_s
+        if tt < ts[0] or tt > ts[-1]:
+            continue
+        j = min(bisect.bisect_right(ts, tt) - 1, len(ts) - 2)
+        a, b = sender[j], sender[j + 1]
+        f = (tt - a[0]) / (b[0] - a[0]) if b[0] > a[0] else 0.0
+        gap = z - (a[2] + (b[2] - a[2]) * f)
+        if a[1] in AIR or b[1] in AIR:
+            air_gaps.append(abs(gap))
+        elif land_after[j] is not None and tt - land_after[j] <= 0.5:
+            land_gaps.append(gap)
+        else:
+            ground_gaps.append(gap)
+            if land_after[j] is not None and tt - land_after[j] > SETTLE_FROM_S:   # W2 D4 (B-8: no cap; land_after resets at the next air run)
+                settle_gaps.append(gap)
+    ep, run = 0, 0   # air episodes: >= 3 consecutive sender samples labelled JUMP/FALL/FLY
+    for s in sender:
+        run = run + 1 if s[1] in AIR else 0
+        if run == 3:
+            ep += 1
+    r = {
+        "sender_samples": len(sender), "viewer_samples": len(viewer), "viewer_recv_air_labels": recv_air,
+        "air_episodes_x3": ep, "n_air": len(air_gaps), "n_land": len(land_gaps), "n_ground": len(ground_gaps),
+        "air_p95_abs": pct(air_gaps, 0.95), "land_p95_abs": pct([abs(g) for g in land_gaps], 0.95),
+        "land_min_gap": min(land_gaps) if land_gaps else None,
+        "ground_p50": pct(ground_gaps, 0.5),
+    }
+    r["settle_n"] = len(settle_gaps)                                         # W2 D4
+    r["settle_min_gap"] = min(settle_gaps) if settle_gaps else None          # W2 D4
+    r["pass_air"] = r["air_p95_abs"] is not None and r["air_p95_abs"] <= 10.0
+    r["pass_land"] = r["land_p95_abs"] is not None and r["land_p95_abs"] <= 2.0
+    r["pass_viewer_reads_motion"] = recv_air > 0
+    r["pass_no_sink"] = None if not settle_gaps else bool(r["settle_min_gap"] >= -SINK_TOLERANCE_UU)   # W2 D4
+    r["PASS"] = bool(r["pass_air"] and r["pass_land"] and r["pass_viewer_reads_motion"] and ep > 0 and r["pass_no_sink"])   # W2 D4
+    return r
+
+
+def best_shift(sender, viewer):
+    """Registered diagnostic; W2 D5: kept for reference, never run by this file or the judge (B2: the -50 ms fit is not used)."""
+    best = None
+    for ms in range(-500, 501, 10):
+        r = analyse(sender, viewer, ms / 1000.0)
+        if r["air_p95_abs"] is not None and (best is None or r["air_p95_abs"] < best[1]):
+            best = (ms, r["air_p95_abs"])
+    return best
+
+
+# ---------------- W2 D3: timing report ---------------------------------------------------------------------------------------------
+def _summ(v, scale=1000.0):
+    if not v:
+        return {"n": 0}
+    return {"n": len(v), "p5": pct(v, 0.05) * scale, "p50": pct(v, 0.5) * scale, "p95": pct(v, 0.95) * scale,
+            "min": min(v) * scale, "max": max(v) * scale}
+
+
+def timing_report(sender_lines, viewer_lines, fig=None, t_from=None, t_to=None):
+    """W2 D3. Within [t_from, t_to] (wall clock, D1/D2 time; None = all):
+      sender_lag_ms / viewer_lag_ms: stamp - D1 time at each world-report anchor of that log (how late the file stamps were);
+      sender_backlog_ms / viewer_backlog_ms: the +/-ENVELOPE_S envelope above the +/-BACKLOG_WINDOW_S one (a queue that never empties);
+      fig_correction_ms: stamp - D2 time of the viewer's fig lines; fig_method: how many fig lines got the exact 'age' time / the 'lag' fallback;
+      link_latency_ms: viewer "rep" time (its answer's soles line, D1) - sender send time (D1) for each sender position received by the viewer
+        whose (x,y,z) is unique among the sender's sends within +/-2 s (standing repeats are ambiguous and skipped); causal and short when both
+        clocks are right."""
+    def inwin(t):
+        return (t_from is None or t >= t_from) and (t_to is None or t <= t_to)
+    sa, ss = world_anchors(sender_lines)
+    va, _ = world_anchors(viewer_lines)
+    rep = {
+        "sender_anchors": len(sa), "viewer_anchors": len(va),
+        "sender_lag_ms": _summ([a["lag"] for a in sa if inwin(a["t"])]),
+        "viewer_lag_ms": _summ([a["lag"] for a in va if inwin(a["t"])]),
+        # backlog indicator: how far the +/-ENVELOPE_S envelope sits above the +/-BACKLOG_WINDOW_S one (a few ms = rounding of period=; more = a backlog)
+        "sender_backlog_ms": _summ([a["excess"] for a in sa if inwin(a["t"])]),
+        "viewer_backlog_ms": _summ([a["excess"] for a in va if inwin(a["t"])]),
+    }
+    figs, reps, _ = viewer_clock(viewer_lines, fig)
+    inw = [(t, m, ts) for (t, m, ts) in figs.values() if inwin(t)]
+    rep["fig_correction_ms"] = _summ([ts - t for (t, m, ts) in inw])
+    rep["fig_method"] = {"age": sum(1 for x in inw if x[1] == "age"), "lag": sum(1 for x in inw if x[1] == "lag")}
+    by_key = {}
+    for s in ss:
+        if s["x"] is None:
+            continue
+        by_key.setdefault(_key(s["x"], s["y"], s["sz"]), []).append(s)
+    lat = []
+    for (i, fg, key, t_cb, ts) in reps:
+        if t_cb is None:
+            continue
+        near = [s for s in by_key.get(key, []) if abs(s["t"] - t_cb) <= 2.0]
+        if len(near) != 1 or not inwin(near[0]["t"]):
+            continue
+        lat.append(t_cb - near[0]["t"])
+    rep["link_latency_ms"] = _summ(lat)
+    rep["link_causality_violations_lt_minus10ms"] = sum(1 for x in lat if x < -0.010)
+    return rep
+
+
+def main(argv):
+    if "--shift-ms" in argv:   # W2 D5
+        print("refused: the time shift is fixed at 0 ms (M2 checklist B2); motion_diag_w2 takes no --shift-ms")
+        return 2
+    fig = None
+    if "--fig" in argv:
+        i = argv.index("--fig")
+        fig = argv[i + 1]
+        del argv[i:i + 2]
+    with open(argv[0], encoding="utf-8", errors="replace") as f:
+        vl = f.read().splitlines()
+    with open(argv[1], encoding="utf-8", errors="replace") as f:
+        sl = f.read().splitlines()
+    sender, viewer = parse_sender_w2(sl), parse_viewer_w2(vl, fig_filter=fig)
+    if len(sender) < 2:
+        print("no sender 'WLREMOTE send motion=' lines")
+        return 2
+    r = analyse(sender, viewer, 0.0)
+    for k, v in r.items():
+        print(f"{k}: {v}")
+    print("best_shift: not computed (W2 D5: shift fixed at 0 ms, M2 checklist B2)")
+    for k, v in timing_report(sl, vl, fig).items():
+        print(f"timing.{k}: {v}")
+    return 0 if r["PASS"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
