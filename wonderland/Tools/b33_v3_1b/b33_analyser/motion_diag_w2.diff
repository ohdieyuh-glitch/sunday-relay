+                figs[i] = (t, "age", ts)
+                n["age"] += 1
+            else:
+                figs[i] = (ts - (lag_at(anchors, i, aidx) or 0.0), "lag", ts)
+                n["lag"] += 1
+    return figs, reps, n
+
