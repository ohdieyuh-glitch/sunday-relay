+def world_anchors(lines):
+    """W2 D1. Every "send motion" line (game time g = cumulative period) and every "send soles" line (g of its send + rtt) of ONE log, placed
+    on the wall clock by the lower envelope of (stamp - g) within +/-ENVELOPE_S game seconds. Returns (anchors, sends):
+      anchors: dicts {i (line index), kind 'send'|'soles', g, stamp, t (wall-clock time from D1), lag (stamp - t, s)} in file order
+      sends:   dicts {i, k, stamp, g, t, lag, motion, z, vz, period_ms, x, y, sz, yaw, rtt_ms, soles_i} one per "send motion" line;
+               x/y/sz/yaw/rtt come from the "send soles" line that answered it (None when it never answered)."""
+    anchors, sends, g = [], [], 0.0
+    for i, ln in enumerate(lines):
+        m = SEND.search(ln)
+        if m:
+            ts = stamp(ln)
+            if ts is None:
+                continue
+            if sends:
+                g += float(m.group(4)) / 1000.0
+            s = {"i": i, "k": len(sends), "stamp": ts, "g": g, "motion": m.group(1), "z": float(m.group(2)), "vz": float(m.group(3)),
+                 "period_ms": float(m.group(4)), "x": None, "y": None, "sz": None, "yaw": None, "rtt_ms": None, "soles_i": None}
+            sends.append(s)
+            anchors.append({"i": i, "kind": "send", "g": g, "stamp": ts, "k": s["k"]})
+            continue
+        m = SOLES.search(ln)
+        if m and sends and sends[-1]["soles_i"] is None:
+            ts = stamp(ln)
+            if ts is None:
+                continue
+            s = sends[-1]
+            s["x"], s["y"], s["sz"] = float(m.group(1)), float(m.group(2)), float(m.group(3))
+            s["rtt_ms"] = float(m.group(4))
+            s["yaw"] = float(m.group(7)) if m.group(7) is not None else None
+            s["soles_i"] = i
+            anchors.append({"i": i, "kind": "soles", "g": s["g"] + s["rtt_ms"] / 1000.0, "stamp": ts, "k": s["k"]})
+    if not anchors:
+        return anchors, sends
+    order = sorted(range(len(anchors)), key=lambda a: anchors[a]["g"])
+    gs = [anchors[a]["g"] for a in order]
+    off = [anchors[a]["stamp"] - anchors[a]["g"] for a in order]
+    env = _sliding_min(gs, off, ENVELOPE_S)
+    env_long = _sliding_min(gs, off, BACKLOG_WINDOW_S)   # W2 D3 only (backlog indicator); never used for a time
+    for pos, a in enumerate(order):
+        A = anchors[a]
+        A["t"] = A["g"] + env[pos]
+        A["lag"] = A["stamp"] - A["t"]
+        A["excess"] = env[pos] - env_long[pos]
+    for A in anchors:
+        if A["kind"] == "send":
+            s = sends[A["k"]]
+            s["t"], s["lag"] = A["t"], A["lag"]
+    return anchors, sends
