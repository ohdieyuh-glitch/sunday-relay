+SEND = re.compile(r"WLREMOTE send motion=(\w+) z=(-?[\d.]+) vz=(-?[\d.]+) period=(-?[\d.]+)ms")
+FIG = re.compile(r"WLREMOTE fig=(\S+) .*?delayMs=(-?[\d.]+)")
+MOT = re.compile(r"WLREMOTE motion fig=(\S+) motion=(\w+) z=(-?[\d.]+)")
+# W2 D1-D3: the other world-report lines (formats byte-unchanged at 8c5c62cb/7f189492)
+SOLES = re.compile(r"WLREMOTE send soles=\((-?[\d.]+),(-?[\d.]+),(-?[\d.]+)\) rtt=(-?[\d.]+)ms period=(-?[\d.]+)ms(?: status=(-?\d+))?(?: yaw=(-?[\d.]+))?")
