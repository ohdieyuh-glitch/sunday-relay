+def stamp(line):
+    m = STAMP.match(line)
+    if not m:
+        return None
+    y, mo, d, h, mi, s, ms = map(int, m.groups())
+    return datetime.datetime(y, mo, d, h, mi, s, ms * 1000, tzinfo=datetime.timezone.utc).timestamp()
