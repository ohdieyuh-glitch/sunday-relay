+def parse_viewer_w2(lines, fig_filter=None, detail=False):
+    """W2 D2: the registered tuple (time, fig, motion, z, delay) where time = the D2 time of the fig line written in the same tick.
+    detail=True appends (stamp of the fig line - time, method)."""
+    figs, _, _ = viewer_clock(lines, fig_filter)
+    cur, delay, out = {}, {}, []
+    for i, ln in enumerate(lines):
+        f = FIG.search(ln)
+        if f:
+            if fig_filter is not None and f.group(1) != fig_filter:
+                continue
+            if i in figs:
+                cur[f.group(1)] = figs[i]
+                delay[f.group(1)] = float(f.group(2)) / 1000.0
+            continue
+        m = MOT.search(ln)
+        if m and m.group(1) in cur:
+            if fig_filter is not None and m.group(1) != fig_filter:
