+SETTLE_FROM_S = 0.5       # W2 D4 (M2 ruling B-8: from 0.5 s after touchdown to the next takeoff or the end of the analysed block; no upper cap)
+SINK_TOLERANCE_UU = 2.0   # W2 D4
