+# ---------------- W2 D1: the log's own game clock -----------------------------------------------------------------------------------
+def _sliding_min(gs, vals, half):
+    """min of vals over |g - g_i| <= half for every i (gs sorted ascending); two pointers + monotone deque, O(n)."""
+    from collections import deque
+    out = [0.0] * len(gs)
+    dq, hi = deque(), 0
+    for idx in range(len(gs)):
+        while hi < len(gs) and gs[hi] <= gs[idx] + half:
+            while dq and vals[dq[-1]] >= vals[hi]:
+                dq.pop()
+            dq.append(hi)
+            hi += 1
+        while dq and gs[dq[0]] < gs[idx] - half:
+            dq.popleft()
+        out[idx] = vals[dq[0]]
+    return out
