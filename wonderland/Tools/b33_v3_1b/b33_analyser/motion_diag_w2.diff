+def parse_sender_w2(lines):
+    """W2 D1: the registered tuple (time, motion, z, vz) with time = the D1 game clock instead of the log stamp."""
+    _, sends = world_anchors(lines)
+    return [(s["t"], s["motion"], s["z"], s["vz"]) for s in sends]
+
