+            reps.append((i, fg, key, t_cb, stamp(ln)))
+            if key != last_key.get(fg):
+                arrival[fg] = (key, t_cb, float(ra.group(1)) if ra else None)
+                last_key[fg] = key
+                last_age.pop(fg, None)
+            continue
+        f = FIGAGE.search(ln)
+        if f:
+            fg = f.group(1)
+            if fig_filter is not None and fg != fig_filter:
+                continue
+            ts = stamp(ln)
+            if ts is None:
+                continue
+            key, age = _key(float(f.group(2)), float(f.group(3)), float(f.group(4))), float(f.group(5))
+            arr, t = arrival.get(fg), None
+            if arr is not None and arr[0] == key and arr[1] is not None and arr[2] is not None:
+                if fg in last_age and age < last_age[fg] - 1.0:
+                    arrival[fg] = (arr[0], None, None)        # RecvAt was reset without a rep line: this arrival is no clock any more
+                else:
