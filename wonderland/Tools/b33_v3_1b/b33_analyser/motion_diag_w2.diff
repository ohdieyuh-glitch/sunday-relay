+# ---------------- W2 D2: viewer lines on the viewer's own clock ---------------------------------------------------------------------
+def lag_at(anchors, i, idx=None):
+    """W2 D2 (fallback): the log's queue lag at file line i: linear in line index between the bracketing anchors (nearest at the ends), >= 0."""
+    if not anchors:
+        return None
+    idx = idx if idx is not None else [a["i"] for a in anchors]
+    j = bisect.bisect_left(idx, i)
+    if j <= 0:
+        lag = anchors[0]["lag"]
+    elif j >= len(anchors):
+        lag = anchors[-1]["lag"]
+    else:
+        a, b = anchors[j - 1], anchors[j]
+        f = (i - a["i"]) / (b["i"] - a["i"]) if b["i"] > a["i"] else 0.0
+        lag = a["lag"] + (b["lag"] - a["lag"]) * f
+    return max(0.0, lag)
+
+
+def _key(x, y, z):
+    return "%.1f,%.1f,%.1f" % (x, y, z)
+
