  {
   "id": "N_SCALE",
   "name": "the world's lit surfaces carry the scene's thousand -- an emissive judged against a white of 1.0 is three orders of magnitude too dark",
   "pass": false,
   "detail": {
    "lamp_rendered_peaks": [],
    "floor": 100.0,
    "lamps_read": 0,
    "note": "Wonderland's white is near 25,000 scene units at the pinned EV100 of 14.2. World materials take Emissive x EmissiveStrength and the strength supplies the thousand, so the product is what matters and a peak near 1 is the failure. A red here with zero lamps read is the reporting path, not the world -- check lamp_materials for the error before believing it"
   }
  },
