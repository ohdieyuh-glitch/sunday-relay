# Wonderland — Vast.ai launch parameters. Copy to your shell env (or `source`
# after filling in) before running ./wonderland-vast.sh. Every value has a safe
# default in the script; override only what you need.
#
# NEVER put secrets here that get committed. The Vast API key lives where `vastai
# set api-key` stores it; the Epic ghcr PAT is supplied at rent time via shell
# vars GHCR_USER/GHCR_PAT (see below). This file holds NO secret.

# --- GHCR (Epic image) auth — a founder-LOCAL shell-variable seam. `create`
#     emits: --login "-u $GHCR_USER -p $GHCR_PAT ghcr.io". Export these in your
#     shell right before running the create command; they are NEVER printed,
#     logged, or written to the repo. Use a GitHub CLASSIC PAT with read:packages.
# export GHCR_USER=<your-github-username>
# export GHCR_PAT=<classic-PAT-read:packages-only>     # SECRET — do not commit

# --- offer selection. Vast RE-ISSUES offer ids on nearly every query, so we do
#     NOT pin one — the tool selects the current best match at rent-time.
export REFERENCE_OFFER=24964770     # the founder's original id (traceability only)
# export OFFER_ID=                  # optional pin; honoured ONLY if still listed, else current best
export GPU_NAME=L40S
export PREFER_GEO=Japan             # soft preference (the founder's pick); falls back to any geo
export MAX_DPH=0.70                 # soft price ceiling for the preferred pick
export EXPECTED_DPH=0.6009          # shown $/hr; the live offer value is authoritative

# --- what we rent
export DISK_GB=200                  # UE 5.8 + build/package headroom (NOT the 10GB default; offer has 969GB)
export IMAGE=ghcr.io/epicgames/unreal-engine:dev-5.8   # the UE dev image IS the environment (no nested container)
export LABEL=wonderland-stream      # the single-instance ceiling key

# --- app config passed into the container (non-secret)
export ALLOWED_ORIGIN=https://sunday-relay.vercel.app
export QUALITY_PROFILE=WONDERLAND_BROWSER_ULTRA
# export WONDERLAND_REPO_URL=https://…/relay.git   # acquire Wonderland source on-instance (may embed a token via env, not here)
# export BUILD_URL=https://…/wonderland-linux.zip  # optional: skip on-instance build, fetch a prebuilt artifact
# export WONDERLAND_SIGNALLING_DOMAIN=wonderland.example.com  # optional: real TLS via certbot (+opens port 80); else self-signed

# --- port plan (small + pinned, because Vast maps discrete ports)
export SIGNALLING_TCP=443
export TURN_PORT=3478
export WEBRTC_UDP_START=50000
export WEBRTC_UDP_COUNT=10          # 50000..50009. REQUIRED_PORTS = 1(ssh)+1(443)+2(3478)+COUNT (+1 for :80 only with a domain) = 14 default

# --- hardware: HARD floors (never selected below) + PREFERRED tier
export MIN_GPU_RAM_GB=40            # L40S ~46GB
export MIN_VCPUS=16                 # hard floor of EFFECTIVE vCPUs
export PREF_VCPUS=32                # preferred effective vCPUs (the founder's profile)
export MIN_RAM_GB=64               # hard RAM floor (prefers ~128GB)
export MIN_RELIABILITY=0.98
