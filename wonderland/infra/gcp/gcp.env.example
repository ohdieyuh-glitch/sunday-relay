# Wonderland — Google Compute Engine GPU parameters.
#
# Copy, fill in, `source` before running ./wonderland-gcp.sh. Every value has a
# default in the script; override only what you need.
#
# THIS FILE HOLDS NO SECRET AND MUST NEVER HOLD ONE. Credentials come from
# Application Default Credentials (`gcloud auth application-default login`) or a
# service account attached to the caller — never a JSON key in the repo. The
# GHCR pull secret for the Epic image is supplied at create time from your shell,
# exactly as the Vast path does it.

# --- project / location -------------------------------------------------
export GCP_PROJECT_ID=                      # REQUIRED. `gcloud projects list`
export GCP_REGION=us-central1
export GCP_ZONE=us-central1-a               # L4 availability is per-zone; preflight checks it
export GCP_SERVICE_ACCOUNT=                 # optional; empty = the instance default SA

# --- the machine --------------------------------------------------------
# SIZED FROM MEASUREMENT, not from what is available. The current RTX 6000 Ada
# runs this workload at 2.3 GB VRAM and 36-40% GPU at 720-1080p H.264. Pixel
# Streaming is NVENC-bound, not compute- or VRAM-bound, so the honest pick is the
# cheapest modern GPU with a good encoder. An A100/H100 would be waste, not
# headroom.
export GCP_GPU_TYPE=nvidia-l4
export GCP_GPU_COUNT=1                      # a hard 1 unless you deliberately raise it
export GCP_MACHINE_TYPE=g2-standard-8       # L4 requires the g2 family; 8 vCPU / 32 GB
# Building UE on the VM wants ~16 vCPU. Either raise this for the build and drop
# back for streaming, or build once and keep the disk.
export GCP_BUILD_MACHINE_TYPE=g2-standard-16

# --- provisioning model -------------------------------------------------
# SPOT is 60-70% cheaper and can be reclaimed with 30s notice. That is fine for
# a rebuild (idempotent, resumable) and NOT fine mid-demo. Default STANDARD;
# switch per run.
export GCP_PROVISIONING_MODEL=STANDARD      # STANDARD | SPOT

# --- disk ---------------------------------------------------------------
export GCP_BOOT_DISK_GB=250                 # UE 5.8 + build + package; the Vast box uses ~200 of 350
export GCP_BOOT_DISK_TYPE=pd-balanced
export GCP_KEEP_DISK_ON_DELETE=false        # true = keep the built engine when the VM is destroyed

# --- cost protection ----------------------------------------------------
export GCP_MAX_RUNTIME_MIN=240              # hard cap; the VM shuts ITSELF down at this age
export GCP_IDLE_SHUTDOWN_MIN=30             # no streaming peer for this long -> self-terminate
export GCP_INSTANCE_NAME=wonderland-stream  # the single-instance ceiling key, as on Vast
export GCP_MAX_INSTANCES=1                  # refuse to create a second one

# --- app config passed to the VM (non-secret) ---------------------------
export ALLOWED_ORIGIN=https://sunday-relay.vercel.app
export QUALITY_PROFILE=WONDERLAND_BROWSER_ULTRA
export IMAGE=ghcr.io/epicgames/unreal-engine:dev-5.8
# export BUILD_URL=                         # optional prebuilt artifact; empty = build on the VM

# --- ports (unchanged from the Vast plan; GCE uses firewall rules) -------
export SIGNALLING_TCP=443
export TURN_PORT=3478
export WEBRTC_UDP_START=50000
export WEBRTC_UDP_COUNT=10

# --- GHCR (Epic image) auth — shell-local, never written here ------------
# export GHCR_USER=<github-username>
# export GHCR_PAT=<classic PAT, read:packages only>   # SECRET
