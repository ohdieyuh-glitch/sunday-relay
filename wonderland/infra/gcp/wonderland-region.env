# WONDERLAND PRODUCTION REGION — stated, never inferred.
#
# The Lightning L4 + trycloudflare stream works and is visibly low-bitrate. Two
# separate causes, and only one of them is distance:
#
#   1. DISTANCE. A quick tunnel terminates wherever Cloudflare puts it, and the
#      GPU is wherever Lightning put it. Neither is pinned, so the media path
#      length is unknown and unrepeatable.
#   2. TRANSPORT. A Cloudflare quick tunnel proxies over TCP/443. WebRTC media
#      forced through a TCP relay loses its congestion behaviour, and the result
#      looks exactly like "heavily compressed and sometimes poor" regardless of
#      how close the GPU is.
#
# So this file pins the region AND the launch path refuses to call a tunnelled
# TCP-relayed stream production-quality. See verify-stream-quality.py: distance
# is necessary and not sufficient, and neither is measured from geography.

# Ordered preference. us-west4 (Las Vegas) first per the founder's requirement.
WL_GCP_REGION="${WL_GCP_REGION:-us-west4}"
WL_GCP_ZONE="${WL_GCP_ZONE:-us-west4-a}"

# THE ALLOW-LIST IS THE GUARD. A region outside it is refused rather than
# deployed with a warning — an east-coast or central GPU is the failure this is
# meant to prevent, and a warning is not a prevention.
WL_GCP_ALLOWED_REGIONS="us-west4 us-west2 us-west1 us-west3"

# L4 is the same class already proven on Lightning, and it has NVENC. A100/H100
# do NOT have an encoder at all — a Pixel Streaming host on one cannot hardware
# encode and will fall back to software H.264 or fail outright.
WL_GCP_MACHINE_TYPE="${WL_GCP_MACHINE_TYPE:-g2-standard-8}"
WL_GCP_ACCELERATOR="${WL_GCP_ACCELERATOR:-type=nvidia-l4,count=1}"

# TURN must be PUBLICLY REACHABLE to be useful. A relay the browser cannot reach
# is worse than no relay: ICE spends its timeout on it before failing over.
WL_TURN_PUBLIC_HOST="${WL_TURN_PUBLIC_HOST:-}"
WL_TURN_PUBLIC_PORT="${WL_TURN_PUBLIC_PORT:-3478}"

# Direct UDP is the goal. These are the ports that must be open on the instance
# for host/srflx candidates to work; without them every session relays.
WL_WEBRTC_UDP_MIN="${WL_WEBRTC_UDP_MIN:-49152}"
WL_WEBRTC_UDP_MAX="${WL_WEBRTC_UDP_MAX:-65535}"
