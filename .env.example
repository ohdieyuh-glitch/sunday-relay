# =============================================================================
# SUNDAY RELAY — ENVIRONMENT CONTRACT (example values only)
# =============================================================================
# Copy to `.env` and fill in locally. `.env` and `.env.*` are gitignored;
# `.env.example` is the only one tracked and it carries NO real value, ever.
#
# Relay is an independent product with its own environment scope. No Alcatraz
# secret is copied here — see docs/REPOSITORY_GOVERNANCE.md §10.
#
# Nothing in the default test, build, demo or CI path reads any of these.
# Every variable below only widens what a LOCAL, explicitly-confirmed run may
# do; leaving the file untouched keeps Relay fully offline.
# =============================================================================


# -----------------------------------------------------------------------------
# RELAY BRIDGE (relay-bridge/) — the browser surface's only backend
# -----------------------------------------------------------------------------
# The bridge runs SERVER-SIDE on your machine. It holds provider auth locally;
# no provider key is ever read in the browser bundle or committed here.

# Port the bridge listens on. Vite proxies /relay-api here (vite.config.mts).
RELAY_BRIDGE_PORT=8790

# Browser origin allowed to call the bridge. Leave empty for the Vite default.
ALLOWED_FRONTEND_ORIGIN=

# REQUIRED (=1) to permit a REAL Claude Code run. The browser equivalent of the
# CLI's --confirm-live. Never inferred; empty means no live run is possible.
RELAY_BRIDGE_CONFIRM_LIVE=

# =1 runs the whole pipeline against the repository's offline fake Claude
# executable: no model call, no spend. Proves the bridge end to end without keys.
RELAY_BRIDGE_FAKE_CLAUDE=

# Depth requested from the architect backend: fast | balanced | deep.
RELAY_BRIDGE_SUNDAY_MODE=balanced

# CROSS-PRODUCT INTEGRATION, and the only one Relay has. The bridge's architect
# leg can route a brief through a running Sunday Alcatraz backend, addressed by
# URL only — no Alcatraz code is imported and no Alcatraz secret is read.
# Leave empty unless you are deliberately running that integration locally.
# Tracked as an open item in the integration PR; governance §11 permits a typed
# integration but not an implementation dependency.
FUSION_BASE_URL=


# -----------------------------------------------------------------------------
# PROMPT ARCHITECT (server-side only)
# -----------------------------------------------------------------------------
# Live mode is EXPLICIT: a key alone never enables a paid call.

# Set to "live" to enable the one architect call. Empty = offline.
RELAY_PROMPT_ARCHITECT_MODE=

# Server-only. NEVER a VITE_ variable, never in the browser bundle.
OPENAI_API_KEY=

# e.g. a chat-completions model your account can reach.
OPENAI_PROMPT_ARCHITECT_MODEL=

# Output ceiling and timeout for that single call.
RELAY_PROMPT_ARCHITECT_MAX_TOKENS=1200
RELAY_PROMPT_ARCHITECT_TIMEOUT_MS=90000


# -----------------------------------------------------------------------------
# REVIEWER RUNTIME (server-side only)
# -----------------------------------------------------------------------------
# The reviewer's provider, model and billing mode are separate facts and must
# each be reported truthfully. Do not infer billing from the executable name.

RELAY_HERMES_EXECUTABLE=hermes
RELAY_HERMES_MODEL=
RELAY_HERMES_PROVIDER=
# api_billed | subscription | portal | local | unknown
RELAY_HERMES_BILLING_MODE=
RELAY_HERMES_TIMEOUT_MS=180000
RELAY_HERMES_MAX_OUTPUT=


# -----------------------------------------------------------------------------
# BROWSER BUILD FLAGS — non-secret URLs and switches ONLY
# -----------------------------------------------------------------------------
# Anything prefixed VITE_ is INLINED INTO THE PUBLIC BUNDLE. Never put a
# provider key, token, or credential in one. Typed in src/relay/vite-env.d.ts
# and read in src/relay/ui/app/store.ts.

# =1 selects the LIVE bridge adapter instead of the offline demo adapter.
VITE_RELAY_LIVE=

# Explicit bridge base URL. Empty = same-origin /relay-api via the Vite proxy.
VITE_RELAY_BRIDGE_URL=
