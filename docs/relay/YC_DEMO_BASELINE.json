{
  "schemaVersion": 1,
  "product": "Sunday Relay",
  "description": "Versioned YC/demo readiness baseline. The readiness check validates the RELAY PRODUCT in the independent repository \u2014 never a branch name and never a commit SHA. It replaces the pre-separation branch/commit anchors, which named an Alcatraz branch and a commit absent from this object store; the retired values are recorded in docs/relay/YC_DEMO_RUNBOOK.md.",
  "repository": {
    "expectedNameWithOwner": "ohdieyuh-glitch/sunday-relay",
    "forbiddenNamesWithOwner": [
      "ohdieyuh-glitch/turbo-broccoli"
    ],
    "note": "Identity is checked from origin, so the check passes on main, on any relay/* branch, and on a detached CI head, and fails in the Alcatraz repository."
  },
