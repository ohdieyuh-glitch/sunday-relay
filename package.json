{
  "name": "sunday-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Sunday Relay \u2014 compound AI mission coordination and agent operations",
  "license": "MIT",
  "bin": {
    "relay": "dist-relay/cli.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohdieyuh-glitch/sunday-relay.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "relay:card-seam:browser-verify": "node scripts/relay-card-seam-browser-verify.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p relay-bridge/tsconfig.json --noEmit && tsc -p relay-hermes-service/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "relay:build": "esbuild src/relay/cli/main.ts --bundle --platform=node --format=cjs --outfile=dist-relay/cli.cjs --banner:js=\"#!/usr/bin/env node\" --log-level=warning",
    "relay:bridge:build": "esbuild relay-bridge/server.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/server.cjs --external:@anthropic-ai/claude-agent-sdk --log-level=warning",
    "relay:bridge": "npm run relay:bridge:build --silent && node dist-relay-bridge/server.cjs",
    "relay:julius:build": "esbuild relay-bridge/julius-live-mission.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/julius-live-mission.cjs --external:@anthropic-ai/claude-agent-sdk --external:pg --log-level=warning",
    "relay:julius:mission": "npm run relay:julius:build --silent && node dist-relay-bridge/julius-live-mission.cjs",
    "relay:julius:preflight:build": "esbuild scripts/julius-live-preflight.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/julius-live-preflight.cjs --external:pg --log-level=warning",
    "julius:recovery-drill:build": "esbuild scripts/julius-recovery-drill-main.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/julius-recovery-drill.cjs --external:pg --log-level=warning",
    "julius:recovery-drill": "npm run julius:recovery-drill:build --silent && node dist-relay-bridge/julius-recovery-drill.cjs",
    "julius:failure-recovery-drill:build": "esbuild scripts/julius-failure-recovery-drill-main.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/julius-failure-recovery-drill.cjs --external:pg --log-level=warning",
    "julius:failure-recovery-drill": "npm run julius:failure-recovery-drill:build --silent && node dist-relay-bridge/julius-failure-recovery-drill.cjs",
    "julius:repair-loop-drill:build": "esbuild scripts/julius-repair-loop-drill-main.ts --bundle --platform=node --format=cjs --outfile=dist-relay-bridge/julius-repair-loop-drill.cjs --external:pg --log-level=warning",
    "julius:repair-loop-drill": "npm run julius:repair-loop-drill:build --silent && node dist-relay-bridge/julius-repair-loop-drill.cjs",
    "relay:julius:preflight": "npm run relay:julius:preflight:build --silent && node dist-relay-bridge/julius-live-preflight.cjs",
    "julius:review-currency": "node scripts/julius-review-currency.mjs",
    "julius:main-provenance": "node scripts/julius-main-provenance.mjs",
    "julius:main-monotonicity": "node scripts/julius-main-monotonicity.mjs",
    "julius:live-preflight": "node scripts/julius-live-preflight-gates.mjs",
    "relay:beta-gate": "node scripts/wonderland-beta-gate.mjs",
    "julius:harness:export": "node scripts/export-julius-harness.mjs",
    "wonderland:hud:preview": "esbuild scripts/wonderland-hud-preview.tsx --bundle --platform=node --format=cjs --outfile=generated/wonderland-hud-preview.cjs --log-level=warning && node generated/wonderland-hud-preview.cjs",
    "julius:harness:check": "node scripts/export-julius-harness.mjs --check",
    "relay": "npm run relay:build --silent && node dist-relay/cli.cjs",
    "relay:test": "vitest run src/relay",
    "relay:surface-parity:check": "node scripts/relay-surface-parity.mjs",
    "relay:surface-parity:check:strict": "node scripts/relay-surface-parity.mjs --strict",
    "relay:yc": "npm run relay:build --silent && node dist-relay/cli.cjs demo yc --presentation",
    "relay:yc:verify": "npm run relay:build --silent && node scripts/relay-yc-verify.mjs",
    "relay:manual": "npm run relay:build --silent && node dist-relay/cli.cjs demo manual",
    "relay:manual:verify": "npm run relay:build --silent && node scripts/relay-manual-verify.mjs",
    "relay:workspace:verify": "npm run relay:build --silent && node dist-relay/cli.cjs workspace verify",
    "relay:claude:contract-verify": "npm run relay:build --silent && node dist-relay/cli.cjs claude contract-verify",
    "relay:claude:live": "npm run relay:build --silent && node dist-relay/cli.cjs claude run --fixture safe-edit --confirm-live",
    "relay:codex:contract-verify": "npm run relay:build --silent && node dist-relay/cli.cjs codex contract-verify",
    "relay:codex:live": "npm run relay:build --silent && node dist-relay/cli.cjs codex run --fixture review-defect --confirm-live",
    "relay:supervised:contract-verify": "npm run relay:build --silent && node dist-relay/cli.cjs supervised contract-verify",
    "relay:supervised:live": "npm run relay:build --silent && node dist-relay/cli.cjs supervised run --fixture safe-edit --confirm-live",
    "relay:persistence:contract-verify": "npm run relay:build --silent && node dist-relay/cli.cjs persistence contract-verify",
    "relay:persistence:recovery-drill": "npm run relay:build --silent && node dist-relay/cli.cjs persistence recovery-drill",
    "relay:cli:demo": "npm run relay:build --silent && node dist-relay/cli.cjs cli demo",
    "relay:cli:demo:plain": "npm run relay:build --silent && node dist-relay/cli.cjs cli demo --plain",
    "relay:cli:contract-verify": "npm run relay:build --silent && node dist-relay/cli.cjs cli contract-verify",
    "relay:yc-demo:check": "npm run relay:build --silent && node dist-relay/cli.cjs yc check",
    "relay:yc-demo:cli": "npm run relay:build --silent && node dist-relay/cli.cjs yc demo",
    "relay:competitive": "npm run relay:build --silent && node dist-relay/cli.cjs demo competitive",
    "relay:mission-control": "npm run relay:build --silent && node dist-relay/cli.cjs demo mission-control",
    "relay:hermes:build": "esbuild relay-hermes-service/main.ts --bundle --platform=node --format=cjs --outfile=dist-relay-hermes/main.cjs --banner:js=\"#!/usr/bin/env node\" --log-level=warning",
    "relay:hermes:start": "node dist-relay-hermes/main.cjs",
    "relay:hermes:dev": "npm run relay:hermes:build --silent && node dist-relay-hermes/main.cjs",
    "relay:hermes:typecheck": "tsc -p relay-hermes-service/tsconfig.json --noEmit",
    "relay:hermes:test": "vitest run relay-hermes-service relay-bridge/reviewer-harness/hermes",
    "relay:executor:build": "esbuild src/relay/workspace/julius-tools/executor-control-plane-main.ts --bundle --platform=node --format=cjs --outfile=dist-relay-executor/main.cjs --external:pg --log-level=warning",
    "relay:sibling-e2e:build": "esbuild scripts/julius-sibling-e2e.ts scripts/julius-provider-independent-evals.ts --bundle --platform=node --format=cjs --outdir=dist-relay-executor --out-extension:.js=.cjs --external:pg --log-level=warning",
    "wonderland:geometry:export": "esbuild scripts/export-wonderland-geometry-fixture.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-geometry-fixture.cjs --log-level=warning && node generated/export-wonderland-geometry-fixture.cjs",
    "wonderland:geometry:check": "esbuild scripts/export-wonderland-geometry-fixture.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-geometry-fixture.cjs --log-level=warning && node generated/export-wonderland-geometry-fixture.cjs --check",
    "wonderland:geometry:verify": "bash wonderland/Tools/geometry-parity-check.sh",
    "wonderland:cpp:syntax": "bash wonderland/Tools/syntax-check.sh",
    "wonderland:usage:verify": "bash wonderland/Tools/usage-subsystem-check.sh",
    "wonderland:ordering:export": "esbuild scripts/export-wonderland-ordering-fixture.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-ordering-fixture.cjs --log-level=warning && node generated/export-wonderland-ordering-fixture.cjs",
    "wonderland:ordering:check": "esbuild scripts/export-wonderland-ordering-fixture.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-ordering-fixture.cjs --log-level=warning && node generated/export-wonderland-ordering-fixture.cjs --check",
    "wonderland:ordering:verify": "bash wonderland/Tools/ordering-parity-check.sh",
    "wonderland:julius:verify": "bash wonderland/Tools/julius-subsystem-check.sh",
    "wonderland:wire:export": "esbuild scripts/export-wonderland-wire-contract.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-wire-contract.cjs --log-level=warning && node generated/export-wonderland-wire-contract.cjs",
    "wonderland:wire:check": "esbuild scripts/export-wonderland-wire-contract.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-wire-contract.cjs --log-level=warning && node generated/export-wonderland-wire-contract.cjs --check",
    "wonderland:wire:fixtures": "esbuild scripts/export-wonderland-wire-fixtures.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-wire-fixtures.cjs --log-level=warning && node generated/export-wonderland-wire-fixtures.cjs",
    "wonderland:wire:fixtures:check": "esbuild scripts/export-wonderland-wire-fixtures.ts --bundle --platform=node --format=cjs --outfile=generated/export-wonderland-wire-fixtures.cjs --log-level=warning && node generated/export-wonderland-wire-fixtures.cjs --check",
    "wonderland:wire:verify": "bash wonderland/Tools/wire-decode-check.sh",
    "wonderland:map:author": "powershell -NoProfile -ExecutionPolicy Bypass -File wonderland/Tools/author-hub-map.ps1",
    "wonderland:map:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File wonderland/Tools/verify-hub-map.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@fontsource/fira-code": "^5.2.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "openai": "^7.3.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
