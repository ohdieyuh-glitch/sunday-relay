        "type": "number",
        "nullable": true,
        "integer": true,
        "min": 0
      },
      "stderrBytes": {
        "type": "number",
        "nullable": true,
        "integer": true,
        "min": 0
      },
      "outputTruncated": {
        "type": "boolean"
      },
      "structuredOutput": {
        "type": "string",
        "enum": [
          "VALID",
          "INVALID",
          "ABSENT"
        ],
        "maxLength": 512
      },
      "structuredOutputErrors": {
        "type": "string[]",
        "maxItems": 16,
        "maxLength": 512
      },
      "proposalsStaged": {
        "type": "number",
        "nullable": true,
        "integer": true,
        "min": 0
      },
      "proposalsAdmitted": {
        "type": "number",
        "integer": true,
        "min": 0
      },
      "artifactCount": {
        "type": "number",
        "integer": true,
        "min": 0
      },
      "redactions": {
        "type": "number",
        "integer": true,
        "min": 0
      },
      "cancellation": {
        "type": "object",
        "nullable": true,
        "fields": {
          "requestedBy": {
            "type": "string",
            "maxLength": 512
          },
          "requestedAt": {
            "type": "string",
            "maxLength": 64
          },
          "confirmedBy": {
            "type": "string",
            "enum": [
              "KILLED",
              "EXITED",
              "NEVER_STARTED"
            ],
            "maxLength": 512
          }
        }
      }
    },
    "CHECKPOINT": {
      "label": {
        "type": "string",
        "maxLength": 512
      },
      "throughSequence": {
        "type": "number",
        "integer": true,
        "min": 0
      },
      "stateHash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "entityCount": {
        "type": "number",
        "integer": true,
        "min": 0
      }
    }
  }
}
